@page
@model MVCSPortTime1.Pages.Turnos.IndexModel
@{
    ViewData["Title"] = "Turnos";
    ViewData["BodyClass"] = "turnos-page";
    ViewData["HideChrome"] = true;
}

<div class="section-header" style="max-width: 1100px; margin: 24px auto 0 auto;">
  <span>Turnos</span>
  <a asp-page="/Index" aria-label="Volver al menú principal">
    <img src="~/img/atras.png" alt="Volver al Menú" class="icono-volver" />
  </a>
</div>

<div class="turnos-shell">
  <section class="card form-card">
    <h2>Nuevo Turno</h2>
    <form class="formulario">
      <label for="cliente">Cliente</label>
      <select id="cliente" name="cliente" aria-label="Cliente">
        <option value="">Seleccionar cliente</option>
        <option value="cliente1">Cliente 1</option>
        <option value="cliente2">Cliente 2</option>
      </select>

      <label for="cancha">Cancha</label>
      <select id="cancha" name="cancha" aria-label="Cancha">
        <option value="">Seleccionar cancha</option>
        <option value="cancha1">Cancha 1</option>
        <option value="cancha2">Cancha 2</option>
      </select>

      <label for="producto">Producto</label>
      <select id="producto" name="producto" aria-label="Producto">
        <option value="">Seleccionar producto</option>
        <option value="pelotas">Pelotas</option>
        <option value="bebidas">Bebidas</option>
      </select>

      <label for="cantidad">Cantidad</label>
      <input type="number" id="cantidad" name="cantidad" min="1" value="1" placeholder="Cantidad">

      <div class="grid-2">
        <div>
          <label for="hora-inicio">Hora de inicio</label>
          <input type="time" id="hora-inicio" name="hora-inicio" aria-label="Hora de inicio">
          <small class="field-hint">Elegí la hora de inicio del turno.</small>
        </div>
        <div>
          <label for="hora-fin">Hora de fin</label>
          <input type="time" id="hora-fin" name="hora-fin" aria-label="Hora de fin">
          <small class="field-hint">Elegí la hora de fin del turno.</small>
        </div>
      </div>

      <div class="form-actions">
        <button type="button" class="btn btn-primary">Crear turno</button>
        <button type="reset" class="btn btn-ghost">Limpiar</button>
        <!-- Se mantiene la flecha como única forma de volver al Home -->
      </div>
    </form>
  </section>

  <section class="card list-card">
    <div class="list-header">
      <h2>Turnos Cargados</h2>
      <div class="toolbar">
        <input type="text" id="buscar" placeholder="Buscar turno..." />
        <button type="button" class="btn btn-secondary">Buscar</button>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Cliente</th>
            <th>Cancha</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th style="width:110px">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td colspan="7" style="text-align:center; color:#eee">No hay turnos cargados.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</div>
