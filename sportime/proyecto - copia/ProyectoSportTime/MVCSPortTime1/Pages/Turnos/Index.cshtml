@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model MVCSPortTime1.Pages.Turnos.IndexModel
@{
    ViewData["Title"] = "Turnos";
}

<div class="section-header">
  <span>Turnos</span>
  <a asp-page="/Index" aria-label="Volver al menú principal">
    <img src="~/img/atras.png" alt="Volver al Menú" class="icono-volver" />
  </a>
</div>

<partial name="Shared/_Feedback" />

<div class="two-col-shell">
  <section class="card form-card">
    <h2>@(Model.EditId == null ? "Nuevo Turno" : $"Editar Turno #{Model.EditId}")</h2>
    <form class="formulario" method="post">
      <input type="hidden" asp-for="EditId" />

      <label for="cancha">Cancha</label>
      <select asp-for="Input.Cancha_ID" class="form-select" asp-items="@(new SelectList(Model.Canchas, "Cancha_ID", "Cancha_ID"))">
        <option value="">-- Seleccione --</option>
      </select>

      <div class="grid-2">
        <div>
          <label asp-for="Input.HoraInicio"></label>
          <input asp-for="Input.HoraInicio" type="datetime-local" />
        </div>
        <div>
          <label asp-for="Input.HoraFin"></label>
          <input asp-for="Input.HoraFin" type="datetime-local" />
        </div>
      </div>

      <div class="form-actions">
        @if (Model.EditId == null)
        {
            <button type="submit" asp-page-handler="Guardar" class="btn btn-primary">Crear turno</button>
        }
        else
        {
            <button type="submit" asp-page-handler="Actualizar" class="btn btn-primary">Actualizar</button>
            <a asp-page="/Turnos/Index" class="btn btn-ghost">Cancelar</a>
        }
        <button type="reset" class="btn btn-ghost">Limpiar</button>
      </div>
    </form>
  </section>

  <section class="card list-card">
    <div class="list-header">
      <h2>Turnos Cargados</h2>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Cancha</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Items?.Count > 0)
          {
            foreach (var t in Model.Items)
            {
              <tr>
                <td>@t.Turno_ID</td>
                <td>@t.Cancha_ID</td>
                <td>@t.HoraInicio</td>
                <td>@t.HoraFin</td>
                <td>
                  <form method="post" style="display:inline">
                    <button type="submit" asp-page-handler="Editar" asp-route-id="@t.Turno_ID" class="btn btn-secondary">Editar</button>
                  </form>
                  <form method="post" style="display:inline" onsubmit="return confirm('¿Eliminar turno #@t.Turno_ID?');">
                    <button type="submit" asp-page-handler="Eliminar" asp-route-id="@t.Turno_ID" class="btn btn-danger">Eliminar</button>
                  </form>
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="5" style="text-align:center;">No hay turnos cargados.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
</div>
