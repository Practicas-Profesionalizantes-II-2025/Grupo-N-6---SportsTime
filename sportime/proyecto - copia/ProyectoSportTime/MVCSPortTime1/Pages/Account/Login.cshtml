@page
@model MVCSPortTime1.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["BodyClass"] = "login-body";
}

<main class="login-container" aria-labelledby="login-title">
    <form method="post" class="login-form login-form--solo" novalidate>
      <h1 id="login-title" class="login-form-title">Sistema de Turnos Deportivos</h1>
      <div class="form-group">
        <label for="username">Usuario o Email</label>
        <input id="username" asp-for="Usuario" placeholder="tu.usuario" autocomplete="username" required aria-required="true">
        <small class="field-hint" id="username-hint">Ej: juan.perez o correo@dominio.com</small>
      </div>

      <div class="form-group">
        <label for="password">Contraseña</label>
        <div class="password-wrapper">
          <input id="password" asp-for="Password" type="password" placeholder="********" autocomplete="current-password" required aria-required="true">
          <button type="button" class="btn-toggle-pass" aria-label="Mostrar u ocultar contraseña" title="Mostrar">??</button>
        </div>
        <small class="field-hint"> • Mínimo 6 caracteres</small>
      </div>

      <div class="login-options">
        <label class="remember-me">
          <input type="checkbox" asp-for="Recordar"> <span>Recordar usuario</span>
        </label>
        <a asp-page="/Account/Register" class="link-forgot" aria-label="Crear cuenta nueva">Crear cuenta</a>
      </div>

      <div class="form-messages" role="alert" aria-live="polite">@Model.Error</div>

      <button type="submit" class="btn-login" disabled>
        <span class="btn-text">Ingresar</span>
        <span class="spinner" aria-hidden="true"></span>
      </button>

      <div class="divider" role="separator" aria-hidden="true"><span>o</span></div>

      <div class="register-box">
        <p>¿Olvidaste tu contraseña? <a href="#" aria-label="Recuperar contraseña (no implementado)">Recuperar</a></p>
      </div>
    </form>

    <footer class="login-footer">
      <small>&copy; @DateTime.Now.Year Sport Time</small>
    </footer>
  </main>

@section Scripts {
<script>
  const $ = s => document.querySelector(s);
  const usernameInput = $('#username');
  const passwordInput = $('#password');
  const rememberCb = document.querySelector('[name="Recordar"]');
  const btnLogin = document.querySelector('.btn-login');
  const togglePassBtn = document.querySelector('.btn-toggle-pass');

  const LS_KEY = 'st_usuario';
  const storedUser = localStorage.getItem(LS_KEY);
  if (storedUser) { usernameInput.value = storedUser; if (rememberCb) rememberCb.checked = true; }

  if (rememberCb) rememberCb.addEventListener('change', () => {
    if (rememberCb.checked && usernameInput.value.trim()) localStorage.setItem(LS_KEY, usernameInput.value.trim());
    else localStorage.removeItem(LS_KEY);
  });

  usernameInput.addEventListener('input', () => {
    if (rememberCb && rememberCb.checked) localStorage.setItem(LS_KEY, usernameInput.value.trim());
    validateForm();
  });
  passwordInput.addEventListener('input', validateForm);

  togglePassBtn.addEventListener('click', () => {
    const showing = passwordInput.type === 'text';
    passwordInput.type = showing ? 'password' : 'text';
    togglePassBtn.textContent = showing ? '??' : '??';
  });

  function validateForm() {
    const userOk = usernameInput.value.trim().length >= 3;
    const passOk = passwordInput.value.trim().length >= 6;
    btnLogin.disabled = !(userOk && passOk);
  }
  validateForm();
</script>
}
