@page
@model MVCSPortTime1.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Productos";
    ViewData["BodyId"] = "productos-page";
}

<div class="section-header">
  <span>Productos</span>
  <a asp-page="/Index" aria-label="Volver al menú principal">
    <img src="~/img/atras.png" alt="Volver al Menú" class="icono-volver" />
  </a>
</div>

<partial name="Shared/_Feedback" />

<div class="two-col-shell">
  <section class="card form-card">
    <h2>Nuevo Producto</h2>
    <form class="formulario" method="post">
      <label asp-for="Input.Tipo"></label>
      <input asp-for="Input.Tipo" placeholder="Tipo" />
      <span asp-validation-for="Input.Tipo" class="field-error"></span>

      <label asp-for="Input.Descripcion"></label>
      <input asp-for="Input.Descripcion" placeholder="Descripción" />
      <span asp-validation-for="Input.Descripcion" class="field-error"></span>

      <label asp-for="Input.ProveedorId">Proveedor</label>
      <select asp-for="Input.ProveedorId" asp-items="Model.ProveedorOptions">
        <option value="">Seleccionar proveedor</option>
      </select>
      <span asp-validation-for="Input.ProveedorId" class="field-error"></span>

      <label asp-for="Input.Precio"></label>
      <input asp-for="Input.Precio" placeholder="0" />
      <span asp-validation-for="Input.Precio" class="field-error"></span>

      <div class="form-actions">
        <button type="submit" asp-page-handler="Guardar" class="btn btn-discreet">Guardar</button>
        <button type="reset" class="btn btn-link-discreet">Limpiar</button>
      </div>
    </form>
  </section>

  <section class="card list-card">
    <div class="list-header">
      <h2>Productos Registrados</h2>
      <div class="toolbar">
        <input type="text" id="buscar" placeholder="Buscar..." />
        <button type="button" class="btn btn-quiet" onclick="filtrarProductos()">Buscar</button>
      </div>
    </div>

    <div class="table-wrap">
      <table id="tablaProductos" class="turnos-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tipo</th>
                <th>Proveedor</th>
                <th>Precio</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Productos?.Count > 0)
        {
            foreach (var p in Model.Productos)
            {
                <tr>
                  <td>@p.Producto_ID</td>
                  <td>@p.TipoProducto</td>
                  <td>@(Model.Proveedores.FirstOrDefault(x => x.Proveedor_ID == p.Proveedor_ID)?.Nombre)</td>
                  <td>@p.Precio</td>
                  <td class="table-actions">
                    <form method="post">
                      <button type="submit" asp-page-handler="Editar" asp-route-id="@p.Producto_ID" class="icon-btn" title="Editar">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z"/></svg>
                        <span class="sr-only">Editar</span>
                      </button>
                    </form>
                    <form method="post" onsubmit="return confirm('¿Eliminar?');">
                      <button type="submit" asp-page-handler="Eliminar" asp-route-id="@p.Producto_ID" class="icon-btn icon-btn-danger" title="Eliminar">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1z"/></svg>
                        <span class="sr-only">Eliminar</span>
                      </button>
                    </form>
                  </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" style="text-align:center;">No hay productos registrados.</td>
            </tr>
        }
        </tbody>
      </table>
    </div>
</section>
</div>

<!-- Modal edición producto -->
<div class="modal fade" id="editProductoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-md modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Editar producto</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="post" class="formulario">
        <div class="modal-body">
          <input type="hidden" asp-for="Input.ProductoId" />
          <label asp-for="Input.Tipo"></label>
          <input asp-for="Input.Tipo" />
          <label asp-for="Input.Descripcion"></label>
          <input asp-for="Input.Descripcion" />
          <label asp-for="Input.ProveedorId">Proveedor</label>
          <select asp-for="Input.ProveedorId" asp-items="Model.ProveedorOptions"></select>
          <label asp-for="Input.Precio"></label>
          <input asp-for="Input.Precio" />
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link-discreet" data-bs-dismiss="modal">Cerrar</button>
          <button type="submit" asp-page-handler="Actualizar" class="btn btn-discreet">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
<script>
function filtrarProductos() {
    var input = document.getElementById("buscar");
    if (!input) return;
    var filter = input.value.toLowerCase();
    var table = document.getElementById("tablaProductos");
    var trs = table.getElementsByTagName("tr");
    for (var i = 1; i < trs.length; i++) {
        var tds = trs[i].getElementsByTagName("td");
        var show = false;
        for (var j = 0; j < tds.length - 1; j++) {
            if (tds[j].innerText.toLowerCase().indexOf(filter) > -1) show = true;
        }
        trs[i].style.display = show ? "" : "none";
    }
}
</script>
@if (ViewData["OpenProductoModal"] as bool? == true)
{
  <script>
    document.addEventListener('DOMContentLoaded',function(){
      var m = new bootstrap.Modal(document.getElementById('editProductoModal'));
      m.show();
    });
  </script>
}
}
