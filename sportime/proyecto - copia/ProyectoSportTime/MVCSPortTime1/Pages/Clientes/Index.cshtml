@page
@model MVCSPortTime1.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
    ViewData["BodyId"] = "clientes-page";
}

<div class="section-header">
    <span>Clientes</span>
    <a asp-page="/Index" aria-label="Volver al menú principal">
        <img src="~/img/atras.png" alt="Volver al Menú" class="icono-volver" />
    </a>
</div>

<partial name="Shared/_Feedback" />

<div class="two-col-shell">
  <section class="card form-card">
    <h2>@(Model.EditId == null ? "Nuevo Cliente" : $"Editar Cliente #{Model.EditId}")</h2>
    <form class="formulario" method="post">
      <input type="hidden" asp-for="EditId" />

      <label asp-for="Input.Nombre"></label>
      <input asp-for="Input.Nombre" />
      <span asp-validation-for="Input.Nombre" class="field-error"></span>

      <label asp-for="Input.Telefono"></label>
      <input asp-for="Input.Telefono" />
      <span asp-validation-for="Input.Telefono" class="field-error"></span>

      <label asp-for="Input.Email"></label>
      <input asp-for="Input.Email" placeholder="cliente@mail.com" />
      <span asp-validation-for="Input.Email" class="field-error"></span>

      <div class="form-actions">
        @if (Model.EditId == null)
        {
            <button type="submit" asp-page-handler="Guardar" class="btn btn-discreet">Guardar</button>
        }
        else
        {
            <button type="submit" asp-page-handler="Actualizar" class="btn btn-discreet">Actualizar</button>
            <a asp-page="/Clientes/Index" class="btn btn-link-discreet">Cancelar</a>
        }
        <button type="reset" class="btn btn-link-discreet">Limpiar</button>
      </div>
    </form>
  </section>

  <section class="card list-card">
    <div class="list-header">
      <h2>Clientes Registrados</h2>
    </div>

    <div class="table-wrap">
      <table class="turnos-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Items?.Count > 0)
          {
            foreach (var c in Model.Items)
            {
              <tr>
                <td>@c.Cliente_ID</td>
                <td>@c.Nombre</td>
                <td>@c.NumeroTelefono</td>
                <td>@c.Email</td>
                <td class="table-actions">
                  <form method="post">
                    <button type="submit" asp-page-handler="Editar" asp-route-id="@c.Cliente_ID" class="icon-btn" title="Editar">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z"/></svg>
                      <span class="sr-only">Editar</span>
                    </button>
                  </form>
                  <form method="post" onsubmit="return confirm('¿Eliminar cliente @c.Nombre?');">
                    <button type="submit" asp-page-handler="Eliminar" asp-route-id="@c.Cliente_ID" class="icon-btn icon-btn-danger" title="Eliminar">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1z"/></svg>
                      <span class="sr-only">Eliminar</span>
                    </button>
                  </form>
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="5" style="text-align:center;">No hay clientes cargados.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Modal edición cliente -->
<div class="modal fade" id="editClienteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-md modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Editar cliente @Model.EditId</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="post" class="formulario">
        <div class="modal-body">
          <input type="hidden" asp-for="EditId" />
          <label asp-for="Input.Nombre"></label>
          <input asp-for="Input.Nombre" />

          <label asp-for="Input.Telefono"></label>
          <input asp-for="Input.Telefono" />

          <label asp-for="Input.Email"></label>
          <input asp-for="Input.Email" />
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link-discreet" data-bs-dismiss="modal">Cerrar</button>
          <button type="submit" asp-page-handler="Actualizar" class="btn btn-discreet">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    @if (Model.EditId != null)
    {
      <script>
        document.addEventListener('DOMContentLoaded',function(){
          var m = new bootstrap.Modal(document.getElementById('editClienteModal'));
          m.show();
        });
      </script>
    }
}
