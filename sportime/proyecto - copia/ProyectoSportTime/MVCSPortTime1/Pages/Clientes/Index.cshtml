@page
@model MVCSPortTime1.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
    ViewData["BodyId"] = "clientes-page";
}

<div class="section-header">
    <span>Clientes</span>
    <a asp-page="/Index" aria-label="Volver al menú principal">
        <img src="~/img/atras.png" alt="Volver al Menú" class="icono-volver" />
    </a>
</div>

<partial name="Shared/_Feedback" />

<div class="two-col-shell">
  <section class="card form-card">
    <h2>@(Model.EditId == null ? "Nuevo Cliente" : $"Editar Cliente #{Model.EditId}")</h2>
    <form class="formulario" method="post">
      <input type="hidden" asp-for="EditId" />

      <label asp-for="Input.Nombre"></label>
      <input asp-for="Input.Nombre" />
      <span asp-validation-for="Input.Nombre" class="field-error"></span>

      <label asp-for="Input.Telefono"></label>
      <input asp-for="Input.Telefono" />
      <span asp-validation-for="Input.Telefono" class="field-error"></span>

      <label asp-for="Input.Email"></label>
      <input asp-for="Input.Email" placeholder="cliente@mail.com" />
      <span asp-validation-for="Input.Email" class="field-error"></span>

      <div class="form-actions">
        @if (Model.EditId == null)
        {
            <button type="submit" asp-page-handler="Guardar" class="btn btn-primary">Guardar</button>
        }
        else
        {
            <button type="submit" asp-page-handler="Actualizar" class="btn btn-primary">Actualizar</button>
            <a asp-page="/Clientes/Index" class="btn btn-ghost">Cancelar</a>
        }
        <button type="reset" class="btn btn-ghost">Limpiar</button>
      </div>
    </form>
  </section>

  <section class="card list-card">
    <div class="list-header">
      <h2>Clientes Registrados</h2>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Items?.Count > 0)
          {
            foreach (var c in Model.Items)
            {
              <tr>
                <td>@c.Cliente_ID</td>
                <td>@c.Nombre</td>
                <td>@c.NumeroTelefono</td>
                <td>@c.Email</td>
                <td>
                  <form method="post" style="display:inline">
                    <button type="submit" asp-page-handler="Editar" asp-route-id="@c.Cliente_ID" class="btn btn-secondary">Editar</button>
                  </form>
                  <form method="post" style="display:inline" onsubmit="return confirm('¿Eliminar cliente @c.Nombre?');">
                    <button type="submit" asp-page-handler="Eliminar" asp-route-id="@c.Cliente_ID" class="btn btn-danger">Eliminar</button>
                  </form>
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="5" style="text-align:center;">No hay clientes cargados.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
