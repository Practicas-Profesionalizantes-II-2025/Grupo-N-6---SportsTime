@page
@model MVCSPortTime1.Pages.Proveedores.IndexModel
@{
    ViewData["Title"] = "Proveedores";
    ViewData["BodyId"] = "proveedores-page";
}

<div class="section-header">
  <span>Proveedores</span>
  <a asp-page="/Index" aria-label="Volver al menú principal">
    <img src="~/img/atras.png" alt="Volver al Menú" class="icono-volver" />
  </a>
</div>

<partial name="Shared/_Feedback" />

<div class="two-col-shell">
  <section class="card form-card">
    <h2>Nuevo Proveedor</h2>
    <form class="formulario" method="post">
      <label asp-for="Input.Razon"></label>
      <input asp-for="Input.Razon" placeholder="Proveedor S.A." />
      <span asp-validation-for="Input.Razon" class="field-error"></span>

      <label asp-for="Input.Direccion"></label>
      <input asp-for="Input.Direccion" placeholder="Dirección" />

      <label asp-for="Input.Telefono"></label>
      <input asp-for="Input.Telefono" placeholder="1123456789" />
      <span asp-validation-for="Input.Telefono" class="field-error"></span>

      <label asp-for="Input.Email"></label>
      <input asp-for="Input.Email" placeholder="contacto@proveedor.com" />
      <span asp-validation-for="Input.Email" class="field-error"></span>

      <div class="form-actions">
        <button type="submit" asp-page-handler="Guardar" class="btn btn-discreet">Guardar</button>
        <button type="reset" class="btn btn-link-discreet">Limpiar</button>
      </div>
    </form>
  </section>

  <section class="card list-card">
    <div class="list-header">
      <h2>Proveedores Registrados</h2>
    </div>

    <div class="table-wrap">
      <table class="turnos-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Razón social</th>
            <th>Dirección</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
        @if (Model.Proveedores?.Count > 0)
        {
            foreach (var p in Model.Proveedores)
            {
                <tr>
                  <td>@p.Proveedor_ID</td>
                  <td>@p.Nombre</td>
                  <td>@p.Direccion</td>
                  <td>@p.Telefono</td>
                  <td>@p.Email</td>
                  <td class="table-actions">
                    <form method="post">
                      <button type="submit" asp-page-handler="Editar" asp-route-id="@p.Proveedor_ID" class="icon-btn" title="Editar">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z"/></svg>
                      </button>
                    </form>
                    <form method="post" onsubmit="return confirm('¿Eliminar proveedor @p.Nombre?');">
                      <button type="submit" asp-page-handler="Eliminar" asp-route-id="@p.Proveedor_ID" class="icon-btn icon-btn-danger" title="Eliminar">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1z"/></svg>
                      </button>
                    </form>
                  </td>
                </tr>
            }
        }
        else
        {
            <tr>
              <td colspan="6" style="text-align:center;">No hay proveedores registrados.</td>
            </tr>
        }
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Modal edición proveedor -->
<div class="modal fade" id="editProveedorModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-md modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Editar proveedor</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="post" class="formulario">
        <div class="modal-body">
          <input type="hidden" asp-for="EditId" />
          <label>Razón social</label>
          <input asp-for="Input.Razon" />
          <label>Dirección</label>
          <input asp-for="Input.Direccion" />
          <label>Teléfono</label>
          <input asp-for="Input.Telefono" />
          <label>Email</label>
          <input asp-for="Input.Email" />
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link-discreet" data-bs-dismiss="modal">Cerrar</button>
          <button type="submit" asp-page-handler="Actualizar" class="btn btn-discreet">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts{
  <partial name="_ValidationScriptsPartial" />
  @if (ViewData["OpenProveedorModal"] as bool? == true)
  {
    <script>
      document.addEventListener('DOMContentLoaded',function(){
        var m = new bootstrap.Modal(document.getElementById('editProveedorModal'));
        m.show();
      });
    </script>
  }
}
