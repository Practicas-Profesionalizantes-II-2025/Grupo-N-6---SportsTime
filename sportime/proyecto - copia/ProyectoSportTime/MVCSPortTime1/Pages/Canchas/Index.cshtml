@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model MVCSPortTime1.Pages.Canchas.IndexModel
@{
    ViewData["Title"] = "Canchas";
    ViewData["BodyId"] = "canchas-page";
}

<div class="section-header">
  <span>Canchas</span>
  <a asp-page="/Index" aria-label="Volver al menú principal">
    <img src="~/img/atras.png" alt="Volver al Menú" class="icono-volver" />
  </a>
</div>

<partial name="Shared/_Feedback" />

<div class="two-col-shell">
  <section class="card form-card">
    <h2>@(Model.EditId == null ? "Nueva Cancha" : $"Editar Cancha #{Model.EditId}")</h2>

    <form class="formulario" method="post">
      <input type="hidden" asp-for="EditId" />
      <label asp-for="Input.DeporteId">Deporte</label>
      <select asp-for="Input.DeporteId" class="form-select"
              asp-items="@(new SelectList(Model.Deportes, "Deporte_ID", "Nombre"))">
        <option value="">-- Seleccione --</option>
      </select>
      <span asp-validation-for="Input.DeporteId" class="field-error"></span>

      <label>
        <input type="checkbox" asp-for="Input.Activa" /> Activa
      </label>

      <div class="form-actions">
        @if (Model.EditId == null)
        {
            <button type="submit" asp-page-handler="Guardar" class="btn btn-primary">Guardar</button>
        }
        else
        {
            <button type="submit" asp-page-handler="Actualizar" class="btn btn-primary">Actualizar</button>
            <a asp-page="/Canchas/Index" class="btn btn-ghost">Cancelar</a>
        }
        <button type="reset" class="btn btn-ghost">Limpiar</button>
      </div>
    </form>
  </section>

  <section class="card list-card">
    <div class="list-header">
      <h2>Canchas Registradas</h2>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Deporte</th>
            <th>Activa</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Items?.Count > 0)
          {
            foreach (var c in Model.Items)
            {
              <tr>
                <td>@c.Cancha_ID</td>
                <td>@Model.Deportes.FirstOrDefault(d=> d.Deporte_ID == c.Deporte_ID)?.Nombre</td>
                <td>@(c.Activa ? "Sí" : "No")</td>
                <td>
                  <form method="post" style="display:inline">
                    <button type="submit" asp-page-handler="Editar" asp-route-id="@c.Cancha_ID" class="btn btn-secondary">Editar</button>
                  </form>
                  <form method="post" style="display:inline" onsubmit="return confirm('¿Eliminar cancha #@c.Cancha_ID?');">
                    <button type="submit" asp-page-handler="Eliminar" asp-route-id="@c.Cancha_ID" class="btn btn-danger">Eliminar</button>
                  </form>
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="4" style="text-align:center;">No hay canchas registradas.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Modal edición cancha -->
<div class="modal fade" id="editCanchaModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-md modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Editar cancha @Model.EditId</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="post" class="formulario">
        <div class="modal-body">
          <input type="hidden" asp-for="EditId" />
          <label asp-for="Input.DeporteId">Deporte</label>
          <select asp-for="Input.DeporteId" class="form-select"
                  asp-items="@(new SelectList(Model.Deportes, "Deporte_ID", "Nombre"))">
            <option value="">-- Seleccione --</option>
          </select>
          <label style="margin-top:6px;"><input type="checkbox" asp-for="Input.Activa" /> Activa</label>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link-discreet" data-bs-dismiss="modal">Cerrar</button>
          <button type="submit" asp-page-handler="Actualizar" class="btn btn-discreet">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts{
  <partial name="_ValidationScriptsPartial" />
  @if (Model.EditId != null)
  {
    <script>
      document.addEventListener('DOMContentLoaded',function(){
        var m = new bootstrap.Modal(document.getElementById('editCanchaModal'));
        m.show();
      });
    </script>
  }
}
