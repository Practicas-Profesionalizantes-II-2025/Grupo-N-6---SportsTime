@{
    ViewData["Title"] = "Inicio - SportTime";
    Layout = "_Layout"; // Si tu _ViewStart ya define el layout, esta línea es opcional
}

@* Mostrar mensajes si existen *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info" role="alert">
        @TempData["Info"]
    </div>
}

@* Menú principal (partial) *@
@await Html.PartialAsync("_MainMenu")

@* Contenido adicional debajo del menú *@
<section class="home-content" style="max-width:1200px;margin:30px auto;padding:0 20px;">
    <div style="background:#fff;padding:28px;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.06);">
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:20px;">
            <div style="flex:1 1 380px;min-width:280px;">
                <h2 style="margin:0 0 10px;font-size:1.6rem;color:#04665a;">Bienvenido a SportTime</h2>
                <p style="color:#333;margin-bottom:16px;">
                    Utiliza las tarjetas del menú para navegar por las secciones principales: Turnos, Canchas, Deportes, Productos, Clientes y Proveedores.
                </p>

                <p style="color:#444;margin-bottom:0.6rem;">
                    Atajos rápidos:
                </p>
                <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:10px;">
                    <a class="btn btn-outline-success" href="@Url.Action("Index", "Turnos")">Ir a Turnos</a>
                    <a class="btn btn-outline-success" href="@Url.Action("Index", "Canchas")">Ir a Canchas</a>
                    <a class="btn btn-outline-success" href="@Url.Action("Index", "Deportes")">Ir a Deportes</a>
                </div>
            </div>

            <div style="flex:0 0 420px;min-width:260px;text-align:center;">
                @* Breve panel con estadísticas o imagen placeholder *@
                <div style="background:linear-gradient(180deg,#eaf9f6,#dff6f1);padding:18px;border-radius:10px;box-shadow:inset 0 2px 0 rgba(255,255,255,0.6);">
                    <h3 style="margin:0 0 6px;color:#024a41;">Resumen rápido</h3>
                    <ul style="list-style:none;padding:0;margin:8px 0 0;color:#06594f;">
                        <li>• Turnos activos: <strong>—</strong></li>
                        <li>• Canchas registradas: <strong>—</strong></li>
                        <li>• Deportes disponibles: <strong>—</strong></li>
                    </ul>
                    <small style="display:block;margin-top:10px;color:#2b6a60;">(Los datos se mostrarán aquí cuando la API/Seed esté disponible)</small>
                </div>
            </div>
        </div>
    </div>
</section>

@* Opcional: sección con tarjetas pequeñas (duplicado accesible del menú) *@
<section style="max-width:1200px;margin:18px auto;padding:0 20px 60px;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;">
        <a class="card text-center p-4" href="@Url.Action("Index", "Turnos")" style="text-decoration:none;border-radius:12px;box-shadow:0 10px 20px rgba(0,0,0,.06);">
            <div style="font-size:32px;color:#04665a;margin-bottom:10px;">📅</div>
            <div style="font-weight:700;color:#034f45;">Turnos</div>
        </a>

        <a class="card text-center p-4" href="@Url.Action("Index", "Canchas")" style="text-decoration:none;border-radius:12px;box-shadow:0 10px 20px rgba(0,0,0,.06);">
            <div style="font-size:32px;color:#04665a;margin-bottom:10px;">⚽</div>
            <div style="font-weight:700;color:#034f45;">Canchas</div>
        </a>

        <a class="card text-center p-4" href="@Url.Action("Index", "Deportes")" style="text-decoration:none;border-radius:12px;box-shadow:0 10px 20px rgba(0,0,0,.06);">
            <div style="font-size:32px;color:#04665a;margin-bottom:10px;">🏅</div>
            <div style="font-weight:700;color:#034f45;">Deportes</div>
        </a>

        <a class="card text-center p-4" href="@Url.Action("Index", "Clientes")" style="text-decoration:none;border-radius:12px;box-shadow:0 10px 20px rgba(0,0,0,.06);">
            <div style="font-size:32px;color:#04665a;margin-bottom:10px;">👥</div>
            <div style="font-weight:700;color:#034f45;">Clientes</div>
        </a>
    </div>
</section>