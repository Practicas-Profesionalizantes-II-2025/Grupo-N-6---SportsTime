@{
    ViewData["Title"] = "Menú Principal";
    ViewData["BodyClass"] = "menu-body";
}

<header class="menu-header">
  <h1>Menú Principal</h1>
</header>

<div class="menu-buttons">
  <a asp-controller="Turnos" asp-action="Index" class="menu-btn">
    <img src="~/img/turnos.png" alt="Turnos">
    <span>Turnos</span>
  </a>

  <a asp-controller="Canchas" asp-action="Index" class="menu-btn">
    <img src="~/img/canchas.png" alt="Canchas">
    <span>Canchas</span>
  </a>

  <a asp-controller="Productos" asp-action="Index" class="menu-btn">
    <img src="~/img/productos.png" alt="Productos">
    <span>Productos</span>
  </a>

  <a asp-controller="Clientes" asp-action="Index" class="menu-btn">
    <img src="~/img/clientes.png" alt="Clientes">
    <span>Clientes</span>
  </a>
</div>