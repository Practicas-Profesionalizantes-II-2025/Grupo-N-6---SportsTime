@* @model List<Shared.Dtos.ClienteDTO>
@{
    ViewData["Title"] = "Clientes";
}


<style>
    body {
        background: #00bfae;
        min-height: 100vh;
        margin: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
    }
    .clientes-container {
        max-width: 900px;
        margin: 40px auto;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18);
        padding: 32px 40px;
    }
    .clientes-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #009688;
        margin-bottom: 24px;
        text-align: left;
    }
    .clientes-form {
        margin-bottom: 24px;
    }
    .clientes-form label {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
    }
    .clientes-form input[type="text"], .clientes-form input[type="number"] {
        width: 100%;
        padding: 8px 10px;
        border-radius: 6px;
        border: 1px solid #bdbdbd;
        font-size: 1rem;
        margin-bottom: 12px;
    }
    .clientes-actions {
        display: flex;
        gap: 12px;
        margin-bottom: 18px;
    }
    .clientes-actions button {
        background: #009688;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 10px 18px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }
    .clientes-actions button:hover {
        background: #00796b;
    }
    .clientes-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 18px;
    }
    .clientes-table th, .clientes-table td {
        border: 1px solid #bdbdbd;
        padding: 10px;
        text-align: center;
    }
    .clientes-table th {
        background: #009688;
        color: #fff;
    }
    .volver-btn {
        float: right;
        background: #009688;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 10px 18px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }
    .volver-btn:hover {
        background: #00796b;
    }
</style>

<div class="clientes-container">
    <div class="clientes-title">Clientes</div>
    <a asp-action="Crear" class="btn btn-success mb-2">Agregar Cliente</a>
    <table class="clientes-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Cliente_ID</td>
                    <td>@cliente.Nombre</td>
                    <td>@cliente.NumeroTelefono</td>
                    <td>
                        <a asp-action="Detalles" asp-route-id="@cliente.Cliente_ID" class="btn btn-info btn-sm">Detalles</a>
                        <a asp-action="Editar" asp-route-id="@cliente.Cliente_ID" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@cliente.Cliente_ID" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="volver-btn" onclick="window.location.href='@Url.Action("Index", "Home")'">Volver</button>
</div> *@