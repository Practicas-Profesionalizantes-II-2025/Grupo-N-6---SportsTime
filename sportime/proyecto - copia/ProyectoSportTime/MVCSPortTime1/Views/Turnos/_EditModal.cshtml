@model MVCSPortTime1.Models.TurnoDTO
@{
    // Se esperan listas en ViewBag: ViewBag.Usuarios, ViewBag.Canchas, ViewBag.Productos (List<TurnoLookupItem> o similar)
    var usuarios = ViewBag.Usuarios as List<MVCSPortTime1.ViewModels.TurnoLookupItem> ?? new();
    var canchas = ViewBag.Canchas as List<MVCSPortTime1.ViewModels.TurnoLookupItem> ?? new();
    var productos = ViewBag.Productos as List<MVCSPortTime1.ViewModels.TurnoLookupItem> ?? new();
}

<div class="modal fade" id="editTurnoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form id="edit-turno-form" method="post" action="@Url.Action("Edit","Turnos")">
        @Html.AntiForgeryToken()
        <div class="modal-header">
          <h5 class="modal-title">Modificar Turno</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" name="Turno_ID" value="@Model.Turno_ID" />

            <div class="mb-3">
                <label class="form-label">Cliente</label>
                <select name="Usuario_ID" class="form-select">
                    <option value="">Seleccionar cliente</option>
                    @foreach(var u in usuarios) {
                        <option value="@u.Id" @@(u.Id == Model.Usuario_ID ? "selected" : "")>@u.Text</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Cancha</label>
                <select name="Cancha_ID" class="form-select">
                    <option value="">Seleccionar cancha</option>
                    @foreach(var c in canchas) {
                        <option value="@c.Id" @@(c.Id == Model.Cancha_ID ? "selected" : "")>@c.Text</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Producto</label>
                <select name="Producto_ID" class="form-select">
                    <option value="">Seleccionar producto</option>
                    @foreach(var p in productos) {
                        <option value="@p.Id" @@(p.Id == Model.Producto_ID ? "selected" : "")>@p.Text</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Cantidad</label>
                <input name="Cantidad" value="@Model.Cantidad" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Hora de inicio</label>
                <input name="Inicio" type="datetime-local" value="@(Model.Inicio==default ? "" : Model.Inicio.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Hora de fin</label>
                <input name="Fin" type="datetime-local" value="@(Model.Fin==default ? "" : Model.Fin.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
            </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>