@model MVCSPortTime1.Models.TurnoDTO
@{
    ViewData["Title"] = "Eliminar Turno";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="main-card" style="max-width:700px; margin:40px auto;">
    <h2>Eliminar Turno</h2>
    <p>¿Estás seguro que querés eliminar el turno <strong>@Model.Turno_ID</strong>?</p>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Turno_ID" />
        <button type="submit" class="btn-eliminar">Eliminar</button>
        <a asp-action="Index" class="btn-volver">Cancelar</a>
    </form>
</div>