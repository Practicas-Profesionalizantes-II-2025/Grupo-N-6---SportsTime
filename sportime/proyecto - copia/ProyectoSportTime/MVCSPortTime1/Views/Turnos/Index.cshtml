@model MVCSPortTime1.ViewModels.TurnoIndexViewModel
@{
    ViewData["Title"] = "Turnos";
    var headerOffset = 140;
    string FormatDateTime(DateTime dt)
    {
        if (dt == default) return "";
        return dt.ToString("dd/MM/yyyy HH:mm");
    }
}

<link rel="stylesheet" href="~/css/turnos.css" />

<section class="turnos-hero">
    <div class="turnos-hero-inner">
        <div class="turnos-hero-title">
            <h1>Turnos</h1>
            <a class="back-btn" href="@Url.Action("Index", "Home")" title="Volver">←</a>
        </div>
    </div>
</section>

<section class="turnos-wrapper" style="--header-offset:@(headerOffset)px;">
    <div class="turnos-left">
        <div class="card form-card">
            <div class="card-body">
                <h2 class="card-title">Nuevo Turno</h2>

                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label">Cliente</label>
                        <select asp-for="NuevoTurno.Usuario_ID" class="form-select">
                            <option value="">Seleccionar cliente</option>
                            @foreach (var u in Model.Usuarios ?? new List<MVCSPortTime1.ViewModels.TurnoLookupItem>())
                            {
                                <option value="@u.Id">@u.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cancha</label>
                        <select asp-for="NuevoTurno.Cancha_ID" class="form-select">
                            <option value="">Seleccionar cancha</option>
                            @foreach (var c in Model.Canchas ?? new List<MVCSPortTime1.ViewModels.TurnoLookupItem>())
                            {
                                <option value="@c.Id">@c.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Producto</label>
                        <select asp-for="NuevoTurno.Producto_ID" class="form-select">
                            <option value="">Seleccionar producto</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cantidad</label>
                        <input asp-for="NuevoTurno.Cantidad" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hora de inicio</label>
                        <input asp-for="NuevoTurno.Inicio" class="form-control" type="datetime-local" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hora de fin</label>
                        <input asp-for="NuevoTurno.Fin" class="form-control" type="datetime-local" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Crear turno</button>
                        <button type="reset" class="btn btn-outline-secondary">Limpiar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="turnos-right">
        <div class="card grid-card">
            <div class="card-body">
                <h2 class="card-title">Turnos Cargados</h2>

                <div class="search-row mb-2">
                    <input id="turno-search" class="form-control search-input" placeholder="Buscar turno..." />
                    <button id="turno-search-btn" class="btn btn-secondary ms-2">Buscar</button>
                </div>

                <div class="grid-wrapper" id="turnos-grid">
                    <table class="table table-borderless table-sm mb-0">
                        <thead>
                            <tr class="table-header">
                                <th>Cliente</th>
                                <th>Cancha</th>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="turnos-tbody">
                            @if (Model?.Turnos != null && Model.Turnos.Count > 0)
                            {
                                foreach (var t in Model.Turnos)
                                {
                                    <tr data-turno-id="@t.Turno_ID">
                                        <td>@(!string.IsNullOrWhiteSpace(t.UsuarioNombre) ? t.UsuarioNombre : t.Usuario_ID.ToString())</td>
                                        <td>@(!string.IsNullOrWhiteSpace(t.CanchaNombre) ? t.CanchaNombre : t.Cancha_ID.ToString())</td>
                                        <td>@(string.IsNullOrWhiteSpace(t.ProductoNombre) ? "" : t.ProductoNombre)</td>
                                        <td>@(t.Cantidad)</td>
                                        <td>@(FormatDateTime(t.Inicio))</td>
                                        <td>@(FormatDateTime(t.Fin))</td>
                                        <td>
                                            <a href="@Url.Action("Edit", "Turnos", new { id = t.Turno_ID })" class="btn btn-sm btn-warning btn-edit">Modificar</a>
                                            <a href="@Url.Action("Delete", "Turnos", new { id = t.Turno_ID })" class="btn btn-sm btn-danger btn-delete">Eliminar</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="text-muted"><td colspan="7" class="text-center">No hay turnos cargados.</td></tr>
                            }
                        </tbody>
                    </table>
                </div> <!-- grid-wrapper -->

            </div>
        </div>
    </div>
</section>

@* Contenedor donde se inyectan los partials modales cargados por AJAX *@
<div id="modal-container"></div>

@section Scripts {
    <script src="~/js/turnos-modals.js"></script>
    <script>
        // keep the simple search functionality
        (function () {
            const searchInput = document.getElementById('turno-search');
            const searchBtn = document.getElementById('turno-search-btn');
            const tbody = document.getElementById('turnos-tbody');

            function filterRows(term) {
                term = (term || '').toLowerCase().trim();
                Array.from(tbody.querySelectorAll('tr')).forEach(function (r) {
                    if (r.classList.contains('text-muted')) {
                        r.style.display = 'none';
                        return;
                    }
                    const text = r.innerText.toLowerCase();
                    r.style.display = text.indexOf(term) === -1 ? 'none' : '';
                });

                const anyVisible = Array.from(tbody.querySelectorAll('tr')).some(r => r.style.display !== 'none');
                const existingFallback = tbody.querySelector('tr.text-muted');
                if (!anyVisible) {
                    if (!existingFallback) {
                        const tr = document.createElement('tr');
                        tr.className = 'text-muted';
                        tr.innerHTML = '<td colspan="7" class="text-center">No hay turnos cargados.</td>';
                        tbody.appendChild(tr);
                    } else {
                        existingFallback.style.display = '';
                    }
                } else if (existingFallback) {
                    existingFallback.style.display = 'none';
                }
            }

            searchInput.addEventListener('input', (e) => {
                filterRows(e.target.value);
            });

            searchBtn.addEventListener('click', () => {
                filterRows(searchInput.value);
            });

            // Inicial: no filtro
            filterRows('');
        })();
    </script>
}