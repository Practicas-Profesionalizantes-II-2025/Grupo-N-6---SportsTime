@{
    ViewData["Title"] = "Gestión de Turnos";
    ViewData["BodyClass"] = "turnos-page";
}

<!-- Barra superior -->
<div class="section-header">
  <span>Turnos</span>
  <a asp-controller="Home" asp-action="Index">
    <img src="~/img/atras.png" alt="Volver al Menú" class="icono-volver" />
  </a>
</div>

<!-- Contenedor general -->
<main class="contenedor">

  <!-- Botón rápido arriba -->
  <button class="btn">Guardar Turno</button>

  <!-- Sección Formulario -->
  <div class="form-section">
    <h2>Nuevo Turno</h2>

    <form class="formulario">
      <label for="cliente">Cliente:</label>
      <select id="cliente">
        <option value="">Seleccionar</option>
        <option value="cliente1">Cliente 1</option>
        <option value="cliente2">Cliente 2</option>
      </select>

      <label for="cancha">Cancha:</label>
      <select id="cancha">
        <option value="">Seleccionar</option>
        <option value="cancha1">Cancha 1</option>
        <option value="cancha2">Cancha 2</option>
      </select>

      <label for="producto">Producto:</label>
      <select id="producto">
        <option value="">Seleccionar</option>
        <option value="pelotas">Pelotas</option>
        <option value="bebidas">Bebidas</option>
      </select>

      <label for="cantidad">Cantidad:</label>
      <input type="number" id="cantidad" min="1" value="1">

      <label for="hora-inicio">Hora de inicio:</label>
      <input type="time" id="hora-inicio">

      <label for="hora-fin">Hora de fin:</label>
      <input type="time" id="hora-fin">

      <!-- Botones -->
      <div class="botones-acciones">
        <button type="button">Guardar</button>
        <button type="button">Modificar</button>
        <button type="button">Eliminar</button>
        <button type="button">Agregar</button>
        <button type="reset">Limpiar</button>
        <a class="btn-volver" asp-controller="Home" asp-action="Index">Volver</a>
      </div>
    </form>
  </div>

  <!-- Sección Lista -->
  <div class="list-section">
    <h2>Turnos Cargados</h2>

    <label for="buscar">Buscar:</label>
    <input type="text" id="buscar" placeholder="Buscar turno...">

    <table>
      <thead>
        <tr>
          <th>Cliente</th>
          <th>Cancha</th>
          <th>Producto</th>
          <th>Cantidad</th>
          <th>Inicio</th>
          <th>Fin</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td colspan="6">No hay turnos cargados.</td>
        </tr>
      </tbody>
    </table>
  </div>

</main>