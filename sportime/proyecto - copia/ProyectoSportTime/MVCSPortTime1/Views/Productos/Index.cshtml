@{
    ViewData["Title"] = "Productos";
    ViewData["BodyId"] = "productos-page";
}

<div class="section-header">
  <span>Productos</span>
  <a asp-controller="Home" asp-action="Index">
    <img src="~/img/atras.png" alt="Volver al Menú" class="icono-volver" />
  </a>
</div>

<div class="container">
    <h1>Productos</h1>
    <form class="formulario">
      <label for="tipo">Tipo</label>
      <input type="text" id="tipo" name="tipo" placeholder="Tipo" required />

      <label for="descripcion">Descripción</label>
      <input type="text" id="descripcion" name="descripcion" placeholder="Descripción" required />

      <label for="proveedor">Proveedor</label>
      <input type="text" id="proveedor" name="proveedor" placeholder="Proveedor" required />

      <button type="button" class="btn-guardar" onclick="alert('Simulación de guardar')">Guardar</button>
    </form>

    <table class="tabla" id="tablaProductos">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tipo</th>
                <th>Descripción</th>
                <th>Proveedor</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td>Pelota</td>
                <td>Pelota de fútbol</td>
                <td>Proveedor A</td>
                <td>
                    <button type="button" class="btn-modificar" onclick="alert('Simulación de modificar')">Modificar</button>
                    <button type="button" class="btn-eliminar" onclick="if(confirm('¿Eliminar producto?')) alert('Simulación de eliminar')">Eliminar</button>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td>Red</td>
                <td>Red de tenis</td>
                <td>Proveedor B</td>
                <td>
                    <button type="button" class="btn-modificar" onclick="alert('Simulación de modificar')">Modificar</button>
                    <button type="button" class="btn-eliminar" onclick="if(confirm('¿Eliminar producto?')) alert('Simulación de eliminar')">Eliminar</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<script>
    function filtrarProductos() {
        var input = document.getElementById("buscar");
        if (!input) return;
        var filter = input.value.toLowerCase();
        var table = document.getElementById("tablaProductos");
        var trs = table.getElementsByTagName("tr");
        for (var i = 1; i < trs.length; i++) {
            var tds = trs[i].getElementsByTagName("td");
            var show = false;
            for (var j = 0; j < tds.length - 1; j++) {
                if (tds[j].innerText.toLowerCase().indexOf(filter) > -1) show = true;
            }
            trs[i].style.display = show ? "" : "none";
        }
    }
</script>
