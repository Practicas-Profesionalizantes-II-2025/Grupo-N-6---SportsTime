@model ProveedorDTO

<style>
   
    .main-card {
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18);
        padding: 36px 32px 32px 32px;
        max-width: 900px;
        margin: 40px auto;
        position: relative;
    }

    .main-card h2 {
        font-size: 2.8rem;
        font-weight: 800;
        color: #009688;
        margin-bottom: 28px;
        letter-spacing: 1px;
        text-shadow: 2px 2px 0 #b2dfdb;
    }

    .form-row {
        display: flex;
        gap: 24px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

        .form-row input, .form-row select {
            padding: 12px;
            border: 2px solid #009688;
            border-radius: 8px;
            font-size: 1.1rem;
            min-width: 180px;
            outline: none;
            margin-bottom: 8px;
        }

    .btn-guardar {
        background: #009688;
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 12px 32px;
        font-size: 1.2rem;
        margin-right: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.10);
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-guardar:hover {
            background: #00796b;
        }

    .btn-volver {
        background: #009688;
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 12px 32px;
        font-size: 1.2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.10);
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 18px;
        display: inline-block;
    }

        .btn-volver:hover {
            background: #00796b;
        }

    .table-proveedores {
        width: 100%;
        border-collapse: collapse;
        margin-top: 12px;
    }

        .table-proveedores th, .table-proveedores td {
            padding: 14px 10px;
            text-align: left;
        }

        .table-proveedores th {
            background: #00796b;
            color: #fff;
            font-size: 1.1rem;
            font-weight: 700;
        }

        .table-proveedores tr:nth-child(even) {
            background: #e0f2f1;
        }

    .btn-modificar {
        background: #ffb300;
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 6px;
        padding: 7px 18px;
        font-size: 1rem;
        margin-right: 6px;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-modificar:hover {
            background: #ffa000;
        }

    .btn-eliminar {
        background: #e53935;
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 6px;
        padding: 7px 18px;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-eliminar:hover {
            background: #b71c1c;
        }
        
</style>

<div class="main-card">
    <h2>Agregar Proveedor</h2>
    <form asp-action="Create" method="post">
        <div class="form-row">
            <input asp-for="Nombre" placeholder="Nombre" />
            <input asp-for="Direccion" placeholder="Dirección" />
            <input asp-for="Email" placeholder="Email" />
            <input asp-for="Telefono" placeholder="Teléfono" />
        </div>
        <button type="submit" class="btn-guardar">Guardar</button>
        <a href="javascript:history.back()" class="btn-volver">Volver</a>
    </form>
</div>
