@model MVCSPortTime1.Models.Dtos.CanchaDTO
@{
    ViewData["Title"] = "Detalle Cancha";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="main-card" style="max-width:700px; margin:40px auto;">
    <h2>Detalle Cancha</h2>
    <dl>
        <dt>ID</dt>
        <dd>@Model.Cancha_ID</dd>
        <dt>Deporte</dt>
        <dd>@Model.Deporte_ID - @Model.DeporteNombre</dd>
        <dt>Activa</dt>
        <dd>@(Model.Activa ? "Sí" : "No")</dd>
    </dl>
    <a asp-action="Index" class="btn-volver">Volver</a>
</div>