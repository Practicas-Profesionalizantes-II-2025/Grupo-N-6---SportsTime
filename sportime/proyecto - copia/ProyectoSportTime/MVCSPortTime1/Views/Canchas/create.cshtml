@using MVCSPortTime1.ViewModels
@model MVCSPortTime1.ViewModels.CanchaIndexViewModel

<style>
    .main-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        max-width: 700px;
        margin: 40px auto;
    }

    .form-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

        .form-row select, .form-row input {
            padding: 10px;
            border: 2px solid #009688;
            border-radius: 8px;
            background: #f8f8f8;
            width: 100%;
            box-sizing: border-box;
        }

    .btn-guardar {
        background: #009688;
        color: #fff;
        padding: 10px 18px;
        border-radius: 8px;
        border: none;
        font-weight: 700;
        cursor: pointer;
    }
</style>

<div class="main-card">
    <h2>Crear Cancha</h2>

    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-row">
            <div style="flex:1 1 0; min-width:200px;">
                <label>Deporte</label>
                <select asp-for="NuevoCancha.Deporte_ID" class="form-control">
                    <option value="">Seleccionar deporte</option>
                    @foreach (var d in Model.Deportes)
                    {
                        <option value="@d.Id">@d.Text</option>
                    }
                </select>
            </div>

            <div style="max-width:160px; display:flex; align-items:center;">
                <label><input asp-for="NuevoCancha.Activa" type="checkbox" /> Activa</label>
            </div>

            <div style="min-width:140px;">
                <button type="submit" class="btn-guardar">Crear</button>
            </div>

            <div style="margin-left:12px;">
                <a asp-action="Index" class="btn-volver">Volver</a>
            </div>
        </div>
    </form>
</div>