@* Partial: Menú principal en tarjetas con SVGs inline (sin depender de CDN).
   Uso: colocar @await Html.PartialAsync("_MainMenu") en _Layout.cshtml o en Views/Home/Index.cshtml
*@
<section class="main-menu-hero" role="region" aria-label="Menú principal">
    <div class="menu-hero-inner">
        <h1 class="menu-title">Menú Principal</h1>

        <nav class="menu-cards" aria-label="Navegación principal">
            <a asp-controller="Turnos" asp-action="Index" class="menu-card" title="Turnos">
                <div class="menu-card-icon" aria-hidden="true">
                    <!-- SVG: calendario/check -->
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="2" y="4" width="20" height="18" rx="3" fill="#dff6f1" />
                        <path d="M8 2v4M16 2v4" stroke="#04665a" stroke-width="1.6" stroke-linecap="round" />
                        <path d="M7 12l3 3 7-7" stroke="#04665a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <div class="menu-card-text">Turnos</div>
            </a>

            <a asp-controller="Canchas" asp-action="Index" class="menu-card" title="Canchas">
                <div class="menu-card-icon" aria-hidden="true">
                    <!-- SVG: cancha/fútbol -->
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="2" y="4" width="20" height="18" rx="3" fill="#dff6f1" />
                        <path d="M12 7v10M7 12h10" stroke="#04665a" stroke-width="1.6" stroke-linecap="round" />
                        <circle cx="12" cy="12" r="2" stroke="#04665a" stroke-width="1.4" fill="none" />
                    </svg>
                </div>
                <div class="menu-card-text">Canchas</div>
            </a>

            <a asp-controller="Deportes" asp-action="Index" class="menu-card" title="Deportes">
                <div class="menu-card-icon" aria-hidden="true">
                    <!-- SVG: medalla/deporte -->
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="2" y="4" width="20" height="18" rx="3" fill="#dff6f1" />
                        <circle cx="12" cy="9" r="2.6" fill="#04665a" />
                        <path d="M8 16l1.5-2 2 1 2-1 1.5 2" stroke="#04665a" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <div class="menu-card-text">Deportes</div>
            </a>

            <a asp-controller="Productos" asp-action="Index" class="menu-card" title="Productos">
                <div class="menu-card-icon" aria-hidden="true">
                    <!-- SVG: caja/producto -->
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="2" y="4" width="20" height="18" rx="3" fill="#dff6f1" />
                        <path d="M7 8l5-3 5 3M7 16v-6M17 16v-6" stroke="#04665a" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <div class="menu-card-text">Productos</div>
            </a>

            <a asp-controller="Clientes" asp-action="Index" class="menu-card" title="Clientes">
                <div class="menu-card-icon" aria-hidden="true">
                    <!-- SVG: usuarios -->
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="2" y="4" width="20" height="18" rx="3" fill="#dff6f1" />
                        <path d="M9 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM15 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="#04665a" />
                        <path d="M4 19c1.5-3 5-4 8-4s6.5 1 8 4" stroke="#04665a" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                </div>
                <div class="menu-card-text">Clientes</div>
            </a>

            <a asp-controller="Proveedores" asp-action="Index" class="menu-card" title="Proveedores">
                <div class="menu-card-icon" aria-hidden="true">
                    <!-- SVG: camión/proveedor -->
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="2" y="4" width="20" height="18" rx="3" fill="#dff6f1" />
                        <path d="M3 16h14v-6h4v6h-1" stroke="#04665a" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="7" cy="18" r="1.4" fill="#04665a" />
                        <circle cx="17" cy="18" r="1.4" fill="#04665a" />
                    </svg>
                </div>
                <div class="menu-card-text">Proveedores</div>
            </a>
        </nav>
    </div>
</section>